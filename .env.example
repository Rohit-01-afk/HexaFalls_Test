# Project General Settings
PROJECT_NAME="Blueprint Eye"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"

# Groq API Settings (Ultra-Fast RAG Text Generation)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_TIMEOUT=60.0
GROQ_TEMPERATURE=0.0
GROQ_TOP_P=0.9
GROQ_MAX_OUTPUT_TOKENS=512

# Gemini API Settings (Image/Diagram Analysis)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"
ENABLE_IMAGE_ANALYSIS=true
GEMINI_TIMEOUT=60.0
GEMINI_TEMPERATURE=0.0
GEMINI_TOP_P=0.9
GEMINI_MAX_OUTPUT_TOKENS=512

# PDF Upload & Processing Settings
MAX_UPLOAD_SIZE_MB=50
MANUAL_STORAGE_PATH="storage/manuals"
PAGE_IMAGE_FORMAT="png"
PAGE_IMAGE_DPI=150
PAGE_IMAGE_STORAGE_PATH="storage/page_images"
METADATA_STORAGE_PATH="storage/metadata"

# Chunking Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=100
CHUNK_STORAGE_PATH="storage/chunks"

# Vector Database & Embeddings Settings
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
CHROMA_COLLECTION="manual_chunks"
CHROMA_PATH="storage/chromadb"

# RAG & Search Pipeline Settings
DEFAULT_TOP_K=3
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.45
RAG_MAX_CONTEXT_CHARS=12000
RAG_ENABLE_SOFT_THRESHOLD=true
RAG_SOFT_THRESHOLD_MARGIN=0.05
DEBUG_RAG_PIPELINE=false
